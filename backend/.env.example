# Copy to backend/.env and fill in. Nothing here is read at import time except
# through config/settings — no other module reaches for os.environ.

# --- Django ---------------------------------------------------------------
# Any long random string. Required in production; dev falls back to a fixed one.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO
# With DEBUG off the traceback stops going to the response, so it has to go
# somewhere. Empty = console only; a path adds a rotating file next to it.
DJANGO_LOG_FILE=
# A tunnelled stand runs with DEBUG off no matter what DJANGO_DEBUG says — the
# technical 404 page lists every route. Set this to 1 only to debug the tunnel.
DJANGO_DEBUG_PUBLIC=0
# How many trusted proxies append to X-Forwarded-For in front of Django. This
# is what every IP rate-limit keys on: too low and the throttle reads a hop the
# caller can forge, letting a rotating header bypass the login/mail ceilings.
# 1 = cloudflared (the stand) or a single load balancer; raise it per hop.
DJANGO_NUM_PROXIES=1

# SQLite in dev. Point at another path to keep the file outside the repo.
# How long a database connection is kept open between requests and Celery
# tasks. 0 restores Django's default of one connection per request; 60 lets a
# worker draining a burst of updates skip the connect handshake each time. On
# Postgres this is a real latency win, on SQLite it barely matters.
DJANGO_CONN_MAX_AGE=60

DJANGO_DB_PATH=

# Console mailer prints verification and reset links to the terminal. In
# production this has to be a real backend (django.core.mail.backends.smtp.EmailBackend)
# — `manage.py check --deploy` fails while it is the console one.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_FROM_EMAIL=Oqim Studio <no-reply@oqim.uz>

# --- Frontend origin ------------------------------------------------------
# Where the Next.js app runs. Needed for CORS and for the WebSocket handshake.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Redis, Channels, Celery ---------------------------------------------
# One Redis serves both the channel layer and the Celery broker in dev.
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# --- Interfeys ------------------------------------------------------------
# Where the Next.js app is reachable. Verification and password-reset mails
# link here, so a code in an inbox is one tap rather than a copy-paste.
FRONTEND_BASE_URL=http://localhost:3000

# --- Telegram -------------------------------------------------------------
# The bot behind the Login Widget ("Telegram orqali kirish"). Its token is what
# verifies the signature on what the widget hands the browser, so it must be
# the same bot whose domain you registered with @BotFather:
#
#   @BotFather -> /setdomain -> pick the bot -> send your app's domain
#
# Give this its own bot, and give that bot the product's name and avatar. It
# is the name Telegram shows on the confirmation screen — somebody signing in
# to Oqim Studio who is asked to authorise "Self Payment" has been given a
# reason to stop, and they are right to.
#
# It must not be a workspace's bot either: those answer customers, this one
# only signs the team in.
#
# Two ways in come from it, and only the first needs the domain above:
#   - the Login Widget, on the registered domain
#   - pressing Start in the bot, from anywhere. After changing this bot run
#     `manage.py telegram_login_webhook` so its updates reach this backend.
#
# Leave empty and the sign-in screens simply show the password form.
TELEGRAM_LOGIN_BOT_TOKEN=
TELEGRAM_LOGIN_BOT_USERNAME=

# Public HTTPS origin Telegram can reach this backend at. In dev this is a
# tunnel (ngrok, cloudflared); <PUBLIC_BASE_URL>/api/telegram/webhook/<bot_id>/
# is what gets registered when a bot is connected.
PUBLIC_BASE_URL=http://localhost:8000

# 1 = no Bot API call ever leaves the machine: sends are recorded and pushed to
# the realtime channel instead. Lets the whole runtime be driven end to end
# without a bot token. Tests always run with this on.
TELEGRAM_OFFLINE=1
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_REQUEST_TIMEOUT=20

# --- Skriptlar ------------------------------------------------------------
# How many Kod blocks may be running at once, and how much of that any one
# workspace may take. Counted in Redis through the Django cache, so these are
# ceilings for the whole deployment and not for one process — see
# apps/engine/script/concurrency.py.
#
# A script is a Node process with a 64 MB heap, so eight is roughly a gigabyte
# and eight busy cores: the shape of a small server, and a number to raise on a
# large one. The per-workspace half is what stops one tenant's hot flow from
# occupying every slot; keep it well under the first.
SCRIPT_MAX_CONCURRENT=8
SCRIPT_MAX_CONCURRENT_PER_WORKSPACE=4

# --- AI agentlar -----------------------------------------------------------
# The credential every model call is made with. Leaving it empty is a supported
# state rather than a broken one: `apps/agents/provider.py` reports
# «sozlanmagan», the «AI agent» block takes its failure exit and writes why into
# the run's trace, and nothing else in the runtime changes — the same shape the
# Kod block uses on a machine with no Node on it.
ANTHROPIC_API_KEY=
#
# 1 = no request ever reaches the model provider: agents answer with a canned
# «[oflayn] …» reply instead. The TELEGRAM_OFFLINE promise for the other network
# dependency — the whole path (block, tools, guard, send, trace) can be driven on
# a laptop with no account. Tests always run with this on.
#
# Default 0 rather than 1, unlike TELEGRAM_OFFLINE: a bot with no token sends
# nothing and everybody notices, while an agent quietly answering «[oflayn] …»
# to real customers is a bot that looks like it is working. Switching it on has
# to be a decision somebody made.
AGENTS_OFFLINE=0
